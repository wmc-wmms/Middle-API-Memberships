{
  "openapi": "3.1.0",
  "info": {
    "title": "Audax Membership Gateway",
    "version": "1.0.0",
    "description": "API pública del middleware. Recepción persistente y procesamiento asíncrono. ProcessID es local. Cancel devuelve 202; se consulta por GetProcessStatus. Upgrades se remiten a UpdateMembershipBatch de Audax."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "TEST local"
    }
  ],
  "paths": {
    "/oauth/token": {
      "post": {
        "summary": "Obtener token de una hora",
        "security": [
          {
            "basic": []
          },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "grant_type"
                ],
                "properties": {
                  "grant_type": {
                    "const": "client_credentials"
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "client_secret": {
                    "type": "string",
                    "writeOnly": true
                  },
                  "scope": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token Bearer opaco",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "const": "Bearer"
                    },
                    "expires_in": {
                      "type": "integer"
                    },
                    "scope": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error de validación, autenticación o autorización",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  }
                }
              }
            }
          },
          "401": {
            "description": "Error de validación, autenticación o autorización",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  }
                }
              }
            }
          },
          "429": {
            "description": "Error de validación, autenticación o autorización",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/InsertMembershipBatch": {
      "post": {
        "summary": "insert",
        "description": "Recibe y guarda antes de enviar. Si el payload contiene upgrades se requiere además memberships:upgrade; override=true requiere memberships:override, habilitación del servidor y permiso oficial de Audax. Update no modifica el precio oficial.",
        "security": [
          {
            "oauth": [
              "memberships:insert"
            ]
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[!-~]+$"
            },
            "description": "Única por cliente y operación lógica. Reutilizar al repetir el mismo envío."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 500,
                "items": {
                  "$ref": "#/components/schemas/InsertMembership"
                }
              },
              "example": [
                {
                  "plan_id": "999",
                  "membership_number": "MEM-001",
                  "national_id": "AB123456",
                  "business_id": "111",
                  "last_name": "Doe",
                  "first_name": "John",
                  "issued_country": "14",
                  "date_of_birth": "1980-05-15",
                  "issued_date": "2027-01-01",
                  "valid_from": "2027-02-01",
                  "valid_to": "2027-03-01",
                  "max_consecutive_days_per_trip": 30,
                  "price": 10,
                  "currency_id": "157"
                }
              ]
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recepción local confirmada, no aceptación final de Audax",
