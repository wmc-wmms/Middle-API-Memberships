# Copiar a .env.prod. Usar un dominio HTTPS real detrás de un proxy.

APP_ENV_FILE=.env.prod

APP_ENV=prod

AUDAX_MODE=live

HOST_PORT=3001

PUBLIC_ORIGIN=https://api.tu-dominio.com

COOKIE_SECURE=true

ADMIN_USERNAME=admin

ADMIN_PASSWORD=REEMPLAZAR_POR_CONTRASENA_PROD_LARGA

POSTGRES_PASSWORD=REEMPLAZAR_POR_HEX_ALEATORIO_PROD

# Configurar credenciales propias en Conexión Audax del entorno PROD.

CONFIG_ENCRYPTION_KEY=REEMPLAZAR_POR_64_CARACTERES_HEX_ALEATORIOS_PROD

TEST_PORTAL_URL=https://test.tu-dominio.com

PROD_PORTAL_URL=https://api.tu-dominio.com

AUDAX_ALLOW_OVERRIDE=false


# Usar solo con compose.public.yaml (un proxy por servidor).
PUBLIC_DOMAIN=api.tu-dominio.com
