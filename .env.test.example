# Copiar a .env.test. Nunca usar las mismas credenciales que en producción.

APP_ENV_FILE=.env.test

APP_ENV=test

AUDAX_MODE=live

HOST_PORT=3000

PUBLIC_ORIGIN=http://127.0.0.1:3000

COOKIE_SECURE=false

ADMIN_USERNAME=admin

ADMIN_PASSWORD=REEMPLAZAR_POR_CONTRASENA_TEST_LARGA

POSTGRES_PASSWORD=REEMPLAZAR_POR_HEX_ALEATORIO_TEST

# Credenciales oficiales: cargarlas desde Conexión Audax en el panel.

CONFIG_ENCRYPTION_KEY=REEMPLAZAR_POR_64_CARACTERES_HEX_ALEATORIOS

AUDAX_ALLOW_OVERRIDE=false



TEST_PORTAL_URL=http://127.0.0.1:3000

PROD_PORTAL_URL=http://127.0.0.1:3001


# Usar solo con compose.public.yaml (un proxy por servidor).
PUBLIC_DOMAIN=api.tu-dominio.com
